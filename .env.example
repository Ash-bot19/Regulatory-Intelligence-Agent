# OpenAI (embeddings + LLM — text-embedding-3-small + gpt-4o-mini)
OPENAI_API_KEY=

# Pinecone (prod/demo)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=rbi_circulars

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regulatory_intelligence
POSTGRES_USER=ria_user
POSTGRES_PASSWORD=

# Chroma (local dev)
CHROMA_PERSIST_DIR=./data/chroma

# Confidence gate
CONFIDENCE_THRESHOLD=0.65

# Scheduler
SCHEDULER_HOUR=2
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata

# Environment: local | demo | prod
ENV=local
